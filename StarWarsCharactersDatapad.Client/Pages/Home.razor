@page "/"

@using StarWarsCharactersDatapad.Client.Application.Abstractions
@using StarWarsCharactersDatapad.Client.Application.DTOs
@using StarWarsCharactersDatapad.Client.Components

@inject IStarWarsDataProvider DataProvider

<div class="search-bar">
    <input type="search"
           class="search-input"
           placeholder="Search characters..."
           aria-label="Search characters"
           value="@SearchText"
           @oninput="OnSearchInput" />
</div>

<div class="character-browser">
    <aside class="character-sidebar">
        <h3>CHARACTERS</h3>

        @if (IsCharactersLoading)
        {
            <p role="status">Loading characters...</p>
        }
        else if (CharactersError is not null)
        {
            <div role="alert">
                <p>@CharactersError</p>
                <button type="button" @onclick="LoadCharactersAsync">
                    Retry
                </button>
            </div>
        }
        else if (Characters.Count == 0)
        {
            <p>No characters found.</p>
        }
        else
        {
            <CharacterList Characters="@Characters"
                           SelectedCharacterId="@SelectedCharacterId"
                           OnCharacterSelected="@SelectCharacterAsync" />
        }

    </aside>


    <section class="character-details">

        @if (IsDetailsLoading)
        {
            <p role="status">Loading character details...</p>
        }
        else if (DetailsError is not null)
        {
            <div role="alert">
                <p>@DetailsError</p>

                <button type="button"
                        @onclick="RetryDetailsAsync">
                    Retry
                </button>
            </div>
        }
        else if (SelectedCharacter is not null)
        {
            <CharacterDetails Character="@SelectedCharacter" />
        }
        else
        {
            <p>Select a character to view details.</p>
        }

    </section>


</div>


<FilmsSection Films="@(SelectedCharacter?.Films ?? Array.Empty<FilmDto>())" />

<div class="transport-grid">
    <TransportSection Title="STARSHIPS"
                      Transports="@(SelectedCharacter?.Starships
                      ?? Array.Empty<TransportDto>())" />

    <TransportSection Title="VEHICLES"
                      Transports="@(SelectedCharacter?.Vehicles
                      ?? Array.Empty<TransportDto>())" />
</div>



@implements IDisposable

@code {
    private IReadOnlyList<CharacterDto> Characters =
        Array.Empty<CharacterDto>();

    private string SearchText = string.Empty;

    private string? SelectedCharacterId;
    private CharacterDetailsDto? SelectedCharacter;

    private bool IsCharactersLoading;
    private string? CharactersError;

    private bool IsDetailsLoading;
    private string? DetailsError;

    private CancellationTokenSource? _searchCts;
    private CancellationTokenSource? _detailsCts;

    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        await LoadCharactersAsync();
    }

    // -----------------------------------------
    // Character list: initial load and retry
    // -----------------------------------------

    private Task LoadCharactersAsync()
    {
        return SearchCharactersAsync(SearchText, debounce: false);
    }

    // -----------------------------------------
    // Search input
    // -----------------------------------------

    private Task OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? string.Empty;

        return SearchCharactersAsync(SearchText, debounce: true);
    }

    // -----------------------------------------
    // Unified character search
    // -----------------------------------------

    private async Task SearchCharactersAsync(
        string search,
        bool debounce)
    {
        // Cancel the previous search.
        _searchCts?.Cancel();

        var cts = new CancellationTokenSource();
        _searchCts = cts;

        try
        {
            if (debounce)
            {
                await Task.Delay(300, cts.Token);
            }

            if (cts.IsCancellationRequested || _disposed)
                return;

            IsCharactersLoading = true;
            CharactersError = null;

            var characters = await DataProvider.GetCharactersAsync(
                string.IsNullOrWhiteSpace(search)
                    ? null
                    : search,
                cts.Token);

            if (!cts.IsCancellationRequested && !_disposed)
            {
                Characters = characters;
            }
        }
        catch (OperationCanceledException)
            when (cts.IsCancellationRequested)
        {
            // Superseded by a newer request.
        }
        catch (Exception)
        {
            if (!cts.IsCancellationRequested && !_disposed)
            {
                CharactersError =
                    "Unable to load characters. Please try again.";
            }
        }
        finally
        {
            if (ReferenceEquals(_searchCts, cts))
            {
                IsCharactersLoading = false;
                _searchCts = null;
            }

            cts.Dispose();
        }
    }

    // -----------------------------------------
    // Character selection
    // -----------------------------------------

    private async Task SelectCharacterAsync(string id)
    {
        _detailsCts?.Cancel();

        var cts = new CancellationTokenSource();
        _detailsCts = cts;

        SelectedCharacterId = id;
        SelectedCharacter = null;

        IsDetailsLoading = true;
        DetailsError = null;

        try
        {
            var details =
                await DataProvider.GetCharacterDetailsAsync(
                    id, cts.Token);

            if (!cts.IsCancellationRequested && !_disposed)
            {
                SelectedCharacter = details;

                if (details is null)
                {
                    DetailsError =
                        "Character details not found.";
                }
            }
        }
        catch (OperationCanceledException)
            when (cts.IsCancellationRequested)
        {
            // Superseded by a newer selection.
        }
        catch (Exception)
        {
            if (!cts.IsCancellationRequested && !_disposed)
            {
                DetailsError =
                    "Unable to load character details. Please try again.";
            }
        }
        finally
        {
            if (ReferenceEquals(_detailsCts, cts))
            {
                IsDetailsLoading = false;
                _detailsCts = null;
            }

            cts.Dispose();
        }
    }

    // -----------------------------------------
    // Retry character details
    // -----------------------------------------

    private Task RetryDetailsAsync()
    {
        return SelectedCharacterId is null
            ? Task.CompletedTask
            : SelectCharacterAsync(SelectedCharacterId);
    }

    // -----------------------------------------
    // Component cleanup
    // -----------------------------------------

    public void Dispose()
    {
        _disposed = true;

        _searchCts?.Cancel();
        _detailsCts?.Cancel();

        // Each running operation disposes its own CTS
        // in its finally block.
    }
}

